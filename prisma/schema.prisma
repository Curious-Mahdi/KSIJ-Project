generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id                     String               @id @default(cuid())
  googleId               String               @unique
  name                   String?
  email                  String?              @unique
  profilePhoto           String?
  jamaat                 String?
  isAdmin                Boolean              @default(false)
  role                   String               @default("USER") // USER, ADMIN
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  listings               DirectoryListing[]
  initiatedConversations Conversation[]       @relation("InitiatedConversations")
  ownedConversations     Conversation[]       @relation("OwnedConversations")
  messages               Message[]
  contactShares          ContactShare[]

  marketplaceListings     MarketplaceListing[]
  communityProperties     CommunityProperty[]  @relation("ManagedProperties")
  marketplaceReports      MarketplaceReport[]
  postedOpportunities     Opportunity[]            @relation("PostedOpportunities")
  opportunityApplications OpportunityApplication[] @relation("OpportunityApplications")
}

model DirectoryListing {
  id                 String            @id @default(cuid())
  ownerId            String
  listingType        String
  name               String
  shortDescription   String
  description        String?
  category           String
  subcategory        String?
  services           String
  skills             String?
  keywords           String?
  location           String?
  serviceArea        String?
  serviceMode        String?
  image              String?
  website            String?
  status             String            @default("PUBLISHED")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  addressLine1       String?
  addressLine2       String?
  area               String?
  city               String?
  country            String?
  coverImage         String?
  latitude           Float?
  longitude          Float?
  pincode            String?
  publishedAt        DateTime?
  sourceNotes        String?
  sourcePage         String?
  sourceReference    String?
  sourceType         String?
  state              String?
  tags               String?
  verificationStatus String            @default("UNVERIFIED")
  verifiedAt         DateTime?
  verifiedById       String?
  conversations      Conversation[]
  contact            DirectoryContact?
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model DirectoryContact {
  id                 String           @id @default(cuid())
  listingId          String           @unique
  phone              String?
  whatsapp           String?
  email              String?
  phoneVisibility    String           @default("CHAT_ONLY")
  whatsappVisibility String           @default("CHAT_ONLY")
  emailVisibility    String           @default("CHAT_ONLY")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  listing            DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                   String              @id @default(cuid())
  listingId            String?
  initiatedById        String
  ownerId              String
  status               String              @default("NEW")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  communityPropertyId  String?
  marketplaceListingId String?
  guestCount           Int?
  preferredDate        String?
  preferredTime        String?
  purpose              String?
  contactShares        ContactShare[]
  communityProperty    CommunityProperty?  @relation(fields: [communityPropertyId], references: [id], onDelete: Cascade)
  initiatedBy          User                @relation("InitiatedConversations", fields: [initiatedById], references: [id], onDelete: Cascade)
  listing              DirectoryListing?   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  marketplaceListing   MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade)
  owner                User                @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages             Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  message        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ContactShare {
  id             String       @id @default(cuid())
  conversationId String
  sharedById     String
  phoneShared    Boolean      @default(false)
  whatsappShared Boolean      @default(false)
  emailShared    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sharedBy       User         @relation(fields: [sharedById], references: [id], onDelete: Cascade)
}

model MarketplaceListing {
  id               String              @id @default(cuid())
  sellerId         String
  category         String
  transactionType  String
  title            String
  shortDescription String
  description      String?
  price            Float?
  currency         String              @default("INR")
  isNegotiable     Boolean             @default(false)
  condition        String?
  location         String?
  city             String?
  area             String?
  propertyType     String?
  bedrooms         Int?
  bathrooms        Int?
  propertyArea     String?
  furnishing       String?
  features         String?
  vehicleType      String?
  brand            String?
  model            String?
  year             Int?
  kilometers       Int?
  status           String              @default("PUBLISHED")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  conversations    Conversation[]
  images           MarketplaceImage[]
  seller           User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reports          MarketplaceReport[]
}

model MarketplaceImage {
  id        String             @id @default(cuid())
  listingId String
  url       String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model CommunityProperty {
  id                 String                   @id @default(cuid())
  name               String
  propertyType       String
  description        String
  managedById        String
  location           String?
  city               String?
  capacity           Int?
  pricing            String?
  facilities         String?
  availabilityInfo   String?
  status             String                   @default("PUBLISHED")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  address            String?
  area               String?
  contactInformation String?
  functionTimings    String?
  pricingDetails     String?
  shortDescription   String
  termsAndConditions String?
  usageTags          String?
  managedBy          User                     @relation("ManagedProperties", fields: [managedById], references: [id], onDelete: Cascade)
  images             CommunityPropertyImage[]
  enquiries          Conversation[]
}

model CommunityPropertyImage {
  id         String            @id @default(cuid())
  propertyId String
  url        String
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  property   CommunityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model MarketplaceReport {
  id         String             @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  details    String?
  status     String             @default("PENDING")
  createdAt  DateTime           @default(now())
  listing    MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}



// ==========================================
// OPPORTUNITIES MODELS
// ==========================================

model Opportunity {
  id                   String   @id @default(cuid())
  type                 String   // JOB, INTERNSHIP, MENTORSHIP, PROJECT, VOLUNTEERING
  title                String
  slug                 String?  @unique
  organisationName     String
  organisationId       String?  // Optional link to DirectoryListing
  postedByUserId       String
  postedByUser         User     @relation("PostedOpportunities", fields: [postedByUserId], references: [id], onDelete: Cascade)
  description          String
  category             String
  skills               String?  // JSON or CSV
  location             String?
  workMode             String?  // REMOTE, HYBRID, ONSITE
  experienceLevel      String?
  employmentType       String?  // FULL_TIME, PART_TIME, CONTRACT, etc.
  compensationMin      Float?
  compensationMax      Float?
  compensationPeriod   String?
  currency             String   @default("INR")
  duration             String?
  startDate            String?
  applicationDeadline  DateTime?
  applicationMethod    String?  // KSIJ_ONE, EXTERNAL
  externalApplicationUrl String?
  status               String   @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PUBLISHED, PAUSED, CLOSED, EXPIRED
  verificationStatus   String   @default("UNVERIFIED") // UNVERIFIED, VERIFIED
  
  mentorCapacity       Int?
  timeCommitment       String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  applications         OpportunityApplication[]
}

model OpportunityApplication {
  id               String      @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation("OpportunityApplications", fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl        String?
  coverMessage     String?
  status           String      @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, SHORTLISTED, INTERVIEW, SELECTED, REJECTED, WITHDRAWN
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// -------------------------------------------------------------
// Admin & Community Models (Services, Events, Facilities, Announcements, Enquiries, Knowledge)
// -------------------------------------------------------------

model KnowledgeDocument {
  id            String           @id @default(cuid())
  title         String
  description   String?
  category      String?
  documentType  String?
  schemeId      String?
  version       String?
  status        String           @default("active")
  language      String           @default("en")
  jurisdiction  String?
  sourceUrl     String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  fileName      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  chunks        KnowledgeChunk[]
}

model KnowledgeChunk {
  id            String            @id @default(cuid())
  documentId    String
  content       String
  chunkIndex    Int
  section       String?
  pageNumber    Int?
  embeddingJson String?
  createdAt     DateTime          @default(now())

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Service {
  id                String   @id @default(cuid())
  title             String
  description       String
  category          String   @default("General")
  eligibility       String?
  requiredDocuments String?
  process           String?
  contactInfo       String?
  faqs              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  date            DateTime
  time            String
  location        String
  imageUrl        String?
  registrationUrl String?
  isImportant     Boolean  @default(false)
  status          String   @default("UPCOMING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Facility {
  id          String            @id @default(cuid())
  name        String
  description String
  location    String
  capacity    Int               @default(50)
  amenities   String?
  imageUrl    String?
  isAvailable Boolean           @default(true)
  contactInfo String?
  rules       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bookings    FacilityBooking[]
}

model FacilityBooking {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  userId      String?
  userName    String
  userEmail   String
  userPhone   String
  eventDate   DateTime
  timeSlot    String
  purpose     String
  status      String   @default("PENDING")
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("General")
  isImportant Boolean  @default(false)
  isPublished Boolean  @default(true)
  linkUrl     String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  category    String   @default("General")
  status      String   @default("PENDING")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id                    String    @id @default(cuid())
  type                  String
  title                 String
  slug                  String?
  organisationName      String
  organisationId        String?
  postedByUserId        String
  description           String
  category              String
  skills                String?
  location              String?
  workMode              String?
  experienceLevel       String?
  employmentType        String?
  compensationMin       Float?
  compensationMax       Float?
  compensationPeriod    String?
  currency              String    @default("INR")
  duration              String?
  startDate             String?
  applicationDeadline   DateTime?
  applicationMethod     String?
  externalApplicationUrl String?
  status                String    @default("ACTIVE")
  verificationStatus    String    @default("UNVERIFIED")
  mentorCapacity        Int?
  timeCommitment        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ==========================================
// CENTRALIZED ASSISTANCE REGISTRY MODELS
// ==========================================

model Organization {
  id           String             @id @default(cuid())
  name         String             @unique
  code         String             @unique
  description  String?
  contactEmail String?
  contactPhone String?
  status       String             @default("ACTIVE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  records          AssistanceRecord[]
  apiKey           String?            @default("ak_live_demo")
  verificationLogs VerificationAuditLog[]
}

model Beneficiary {
  id                 String             @id @default(cuid())
  beneficiaryId      String             @unique // e.g. "BEN-000101"
  name               String
  phone              String
  area               String
  familySize         Int                @default(1)
  verificationStatus String             @default("VERIFIED") // VERIFIED, PENDING, UNVERIFIED
  verificationRef    String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assistanceRecords  AssistanceRecord[]

  @@index([phone])
  @@index([name])
  @@index([area])
  @@index([beneficiaryId])
}

model AssistanceRecord {
  id             String       @id @default(cuid())
  beneficiaryId  String
  beneficiary    Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category       String       // "Medical Assistance", "Food Support", "Education / Scholarship", etc.
  amount         Float
  date           DateTime     @default(now())
  status         String       @default("COMPLETED")
  purpose        String?
  notes          String?
  privateNotes   String?      // Organization's strictly private case worker notes
  caseReference  String?      // Internal case/dossier reference
  isPrivate      Boolean      @default(true)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([beneficiaryId])
  @@index([organizationId])
  @@index([category])
  @@index([date])
}

model CentralVerificationRecord {
  id                   String   @id @default(cuid())
  beneficiaryReference String   // e.g. "BEN-000123"
  category             String   // e.g. "Medical Assistance"
  lastAssistanceDate   DateTime
  status               String   @default("ACTIVE")
  reviewRequired       Boolean  @default(true)
  sourceAttestation    String   @default("AUTHORIZED_MEMBER_FOUNDATION")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([beneficiaryReference])
  @@index([category])
}

model VerificationAuditLog {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  beneficiaryReference String
  category             String
  action               String       // "VERIFICATION_CHECK", "ASSISTANCE_RECORDED", "ACCESS_DENIED"
  result               String       // "RELEVANT_ASSISTANCE_FOUND", "CLEARED", "BLOCKED"
  reviewRequired       Boolean      @default(false)
  details              String?
  createdAt            DateTime     @default(now())

  @@index([organizationId])
  @@index([beneficiaryReference])
  @@index([createdAt])
}
