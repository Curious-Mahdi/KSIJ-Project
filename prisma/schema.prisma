generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String               @id @default(cuid())
  googleId               String               @unique
  name                   String?
  email                  String?              @unique
  profilePhoto           String?
  jamaat                 String?
  isAdmin                Boolean              @default(false)
  role                   String               @default("USER") // USER, ADMIN
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  listings               DirectoryListing[]
  initiatedConversations Conversation[]       @relation("InitiatedConversations")
  ownedConversations     Conversation[]       @relation("OwnedConversations")
  messages               Message[]
  contactShares          ContactShare[]
  CommunityProperty      CommunityProperty[]
  MarketplaceListing     MarketplaceListing[]
  MarketplaceReport      MarketplaceReport[]
}

model DirectoryListing {
  id                 String            @id @default(cuid())
  ownerId            String
  listingType        String            // BUSINESS, SERVICE, PROFESSIONAL
  name               String
  shortDescription   String
  description        String?
  category           String
  subcategory        String?
  services           String
  skills             String?
  keywords           String?
  location           String?
  serviceArea        String?
  serviceMode        String?
  image              String?
  website            String?
  status             String            @default("PUBLISHED")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  addressLine1       String?
  addressLine2       String?
  area               String?
  city               String?
  country            String?
  coverImage         String?
  latitude           Float?
  longitude          Float?
  pincode            String?
  publishedAt        DateTime?
  sourceNotes        String?
  sourcePage         String?
  sourceReference    String?
  sourceType         String?
  state              String?
  tags               String?
  verificationStatus String            @default("PENDING")
  verifiedAt         DateTime?
  verifiedById       String?

  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contact            DirectoryContact?
  conversations      Conversation[]
}

model DirectoryContact {
  id                 String           @id @default(cuid())
  listingId          String           @unique
  phone              String?
  whatsapp           String?
  email              String?
  phoneVisibility    String           @default("CHAT_ONLY")
  whatsappVisibility String           @default("CHAT_ONLY")
  emailVisibility    String           @default("CHAT_ONLY")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  listing            DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                   String              @id @default(cuid())
  listingId            String?
  initiatedById        String
  ownerId              String
  status               String              @default("NEW")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  communityPropertyId  String?
  marketplaceListingId String?

  listing              DirectoryListing?   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiatedBy          User                @relation("InitiatedConversations", fields: [initiatedById], references: [id], onDelete: Cascade)
  owner                User                @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages             Message[]
  contactShares        ContactShare[]
  CommunityProperty    CommunityProperty?  @relation(fields: [communityPropertyId], references: [id], onDelete: Cascade)
  MarketplaceListing   MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade)
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  message        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ContactShare {
  id             String       @id @default(cuid())
  conversationId String
  sharedById     String
  phoneShared    Boolean      @default(false)
  whatsappShared Boolean      @default(false)
  emailShared    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sharedBy       User         @relation(fields: [sharedById], references: [id], onDelete: Cascade)
}

model CommunityProperty {
  id                 String                   @id @default(cuid())
  name               String
  propertyType       String
  description        String
  managedById        String
  location           String?
  city               String?
  capacity           Int?
  pricing            String?
  facilities         String?
  availabilityInfo   String?
  status             String                   @default("PUBLISHED")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  address            String?
  area               String?
  contactInformation String?
  functionTimings    String?
  pricingDetails     String?
  shortDescription   String
  termsAndConditions String?
  usageTags          String?

  User                   User                     @relation(fields: [managedById], references: [id], onDelete: Cascade)
  CommunityPropertyImage CommunityPropertyImage[]
  Conversation           Conversation[]
}

model CommunityPropertyImage {
  id                String            @id @default(cuid())
  propertyId        String
  url               String
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())

  CommunityProperty CommunityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model MarketplaceListing {
  id                String              @id @default(cuid())
  sellerId          String
  category          String
  transactionType   String
  title             String
  shortDescription  String
  description       String?
  price             Float?
  currency          String              @default("INR")
  isNegotiable      Boolean             @default(false)
  condition         String?
  location          String?
  city              String?
  area              String?
  propertyType      String?
  bedrooms          Int?
  bathrooms         Int?
  propertyArea      String?
  furnishing        String?
  features          String?
  vehicleType       String?
  brand             String?
  model             String?
  year              Int?
  kilometers        Int?
  status            String              @default("PUBLISHED")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  User              User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  Conversation      Conversation[]
  MarketplaceImage  MarketplaceImage[]
  MarketplaceReport MarketplaceReport[]
}

model MarketplaceImage {
  id                 String             @id @default(cuid())
  listingId          String
  url                String
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())

  MarketplaceListing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model MarketplaceReport {
  id                 String             @id @default(cuid())
  listingId          String
  reporterId         String
  reason             String
  details            String?
  status             String             @default("PENDING")
  createdAt          DateTime           @default(now())

  MarketplaceListing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  User               User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Admin & Community Models (Services, Events, Facilities, Announcements, Enquiries, Knowledge)
// -------------------------------------------------------------

model KnowledgeDocument {
  id            String           @id @default(cuid())
  title         String
  description   String?
  category      String?
  documentType  String?
  schemeId      String?
  version       String?
  status        String           @default("active")
  language      String           @default("en")
  jurisdiction  String?
  sourceUrl     String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  fileName      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  chunks        KnowledgeChunk[]
}

model KnowledgeChunk {
  id            String            @id @default(cuid())
  documentId    String
  content       String
  chunkIndex    Int
  section       String?
  pageNumber    Int?
  embeddingJson String?
  createdAt     DateTime          @default(now())

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Service {
  id                String   @id @default(cuid())
  title             String
  description       String
  category          String   @default("General")
  eligibility       String?
  requiredDocuments String?
  process           String?
  contactInfo       String?
  faqs              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  date            DateTime
  time            String
  location        String
  imageUrl        String?
  registrationUrl String?
  isImportant     Boolean  @default(false)
  status          String   @default("UPCOMING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Facility {
  id          String            @id @default(cuid())
  name        String
  description String
  location    String
  capacity    Int               @default(50)
  amenities   String?
  imageUrl    String?
  isAvailable Boolean           @default(true)
  contactInfo String?
  rules       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bookings    FacilityBooking[]
}

model FacilityBooking {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  userId      String?
  userName    String
  userEmail   String
  userPhone   String
  eventDate   DateTime
  timeSlot    String
  purpose     String
  status      String   @default("PENDING")
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("General")
  isImportant Boolean  @default(false)
  isPublished Boolean  @default(true)
  linkUrl     String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  category    String   @default("General")
  status      String   @default("PENDING")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
