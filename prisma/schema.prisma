generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id             String   @id @default(cuid())
  googleId       String   @unique
  name           String?
  email          String?  @unique
  profilePhoto   String?
  jamaat         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings               DirectoryListing[]
  initiatedConversations Conversation[]     @relation("InitiatedConversations")
  ownedConversations     Conversation[]     @relation("OwnedConversations")
  messages               Message[]
  contactShares          ContactShare[]
}

model DirectoryListing {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  listingType      String   // BUSINESS, SERVICE, PROFESSIONAL
  name             String   // Business name or Professional name
  shortDescription String
  description      String?
  
  category         String
  subcategory      String?
  services         String   // JSON string or comma separated
  skills           String?  // JSON string or comma separated
  keywords         String?  // JSON string or comma separated
  
  location         String?
  serviceArea      String?
  serviceMode      String?  // Online, In-person, Both
  
  image            String?
  website          String?
  
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, PAUSED, ARCHIVED
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contact          DirectoryContact?
  conversations    Conversation[]
}

model DirectoryContact {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  phone              String?
  whatsapp           String?
  email              String?
  
  phoneVisibility    String   @default("CHAT_ONLY") // PUBLIC, CHAT_ONLY, PRIVATE
  whatsappVisibility String   @default("CHAT_ONLY")
  emailVisibility    String   @default("CHAT_ONLY")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Conversation {
  id           String   @id @default(cuid())
  listingId    String
  listing      DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  initiatedById String
  initiatedBy  User     @relation("InitiatedConversations", fields: [initiatedById], references: [id], onDelete: Cascade)
  
  ownerId      String
  owner        User     @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  
  status       String   @default("NEW") // NEW, IN_CONVERSATION, CONTACT_SHARED, COMPLETED, CLOSED
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages       Message[]
  contactShares  ContactShare[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  message        String
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactShare {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  sharedById     String
  sharedBy       User     @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  
  phoneShared    Boolean  @default(false)
  whatsappShared Boolean  @default(false)
  emailShared    Boolean  @default(false)
  
  createdAt      DateTime @default(now())
}

model KnowledgeDocument {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String?
  documentType  String?
  schemeId      String?
  version       String?
  status        String   @default("active")
  language      String   @default("en")
  jurisdiction  String?
  sourceUrl     String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  fileName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chunks        KnowledgeChunk[]
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  documentId    String
  content       String
  chunkIndex    Int
  section       String?
  pageNumber    Int?
  
  // 384 dimensions is standard for all-MiniLM-L6-v2
  embedding     Unsupported("vector(384)")?

  createdAt     DateTime @default(now())

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
