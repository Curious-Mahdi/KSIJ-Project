generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  googleId       String   @unique
  name           String?
  email          String?  @unique
  profilePhoto   String?
  jamaat         String?
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings               DirectoryListing[]
  initiatedConversations Conversation[]     @relation("InitiatedConversations")
  ownedConversations     Conversation[]     @relation("OwnedConversations")
  messages               Message[]
  contactShares          ContactShare[]

  marketplaceListings    MarketplaceListing[]
  communityProperties    CommunityProperty[] @relation("ManagedProperties")
  marketplaceReports     MarketplaceReport[]
}

model DirectoryListing {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  listingType      String   // BUSINESS, SERVICE, PROFESSIONAL
  name             String   // Business name or Professional name
  shortDescription String
  description      String?
  
  category         String
  subcategory      String?
  services         String   // JSON string or comma separated
  skills           String?  // JSON string or comma separated
  keywords         String?  // JSON string or comma separated
  
  location         String?
  serviceArea      String?
  serviceMode      String?  // Online, In-person, Both
  
  image            String?
  website          String?
  
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, PAUSED, ARCHIVED
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contact          DirectoryContact?
  conversations    Conversation[]
}

model DirectoryContact {
  id                 String   @id @default(cuid())
  listingId          String   @unique
  listing            DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  phone              String?
  whatsapp           String?
  email              String?
  
  phoneVisibility    String   @default("CHAT_ONLY") // PUBLIC, CHAT_ONLY, PRIVATE
  whatsappVisibility String   @default("CHAT_ONLY")
  emailVisibility    String   @default("CHAT_ONLY")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Conversation {
  id           String   @id @default(cuid())
  
  // Polymorphic relations (one of these will be set)
  listingId    String?
  listing      DirectoryListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  marketplaceListingId String?
  marketplaceListing   MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id], onDelete: Cascade)
  
  communityPropertyId  String?
  communityProperty    CommunityProperty? @relation(fields: [communityPropertyId], references: [id], onDelete: Cascade)
  
  initiatedById String
  initiatedBy  User     @relation("InitiatedConversations", fields: [initiatedById], references: [id], onDelete: Cascade)
  
  ownerId      String
  owner        User     @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  
  status       String   @default("NEW") // NEW, IN_CONVERSATION, CONTACT_SHARED, COMPLETED, CLOSED
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages       Message[]
  contactShares  ContactShare[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  message        String
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactShare {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  sharedById     String
  sharedBy       User     @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  
  phoneShared    Boolean  @default(false)
  whatsappShared Boolean  @default(false)
  emailShared    Boolean  @default(false)
  
  createdAt      DateTime @default(now())
}

// ==========================================
// MARKETPLACE MODELS
// ==========================================

model MarketplaceListing {
  id               String   @id @default(cuid())
  sellerId         String
  seller           User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  category         String   // PROPERTY, VEHICLES, ELECTRONICS, FURNITURE, HOME_APPLIANCES, BOOKS_EDUCATION, CLOTHING_ACCESSORIES, OTHER
  transactionType  String   // SALE, RENT, LEASE, FREE, OTHER
  
  title            String
  shortDescription String
  description      String?
  
  price            Float?
  currency         String   @default("INR")
  isNegotiable     Boolean  @default(false)
  
  condition        String?  // New, Used - Good, Used - Fair
  
  // Location
  location         String?
  city             String?
  area             String?
  
  // Property Specific fields
  propertyType     String?  // Residential, Commercial, Land, Other
  bedrooms         Int?
  bathrooms        Int?
  propertyArea     String?
  furnishing       String?  // Furnished, Semi-furnished, Unfurnished
  features         String?  // JSON or CSV
  
  // Vehicle Specific fields
  vehicleType      String?
  brand            String?
  model            String?
  year             Int?
  kilometers       Int?
  
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, PAUSED, SOLD, RENTED, CLOSED, ARCHIVED
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images           MarketplaceImage[]
  conversations    Conversation[]
  reports          MarketplaceReport[]
}

model MarketplaceImage {
  id                 String   @id @default(cuid())
  listingId          String
  listing            MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url                String
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
}

model CommunityProperty {
  id               String   @id @default(cuid())
  name             String
  propertyType     String   // Hall, Imambara, Resort, Event Space, Sports Facility, Other
  description      String
  
  managedById      String
  managedBy        User     @relation("ManagedProperties", fields: [managedById], references: [id], onDelete: Cascade)
  
  location         String?
  city             String?
  
  capacity         Int?
  pricing          String?  // E.g. "₹5,000 onwards"
  facilities       String?  // JSON or CSV
  availabilityInfo String?
  
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, PAUSED, ARCHIVED
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images           CommunityPropertyImage[]
  enquiries        Conversation[]
}

model CommunityPropertyImage {
  id                 String   @id @default(cuid())
  propertyId         String
  property           CommunityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url                String
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
}

model MarketplaceReport {
  id                 String   @id @default(cuid())
  listingId          String
  listing            MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  reporterId         String
  reporter           User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  
  reason             String   // Scam, Misleading, Prohibited, Inappropriate, Duplicate, Other
  details            String?
  
  status             String   @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTION_TAKEN
  
  createdAt          DateTime @default(now())
}
